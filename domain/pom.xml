<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tatkalrush</groupId>
    <artifactId>tatkal-rush</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>domain</artifactId>
  <name>domain (pure domain model, zero framework dependencies)</name>

  <!--
    THE critical constraint (SDD 8.2). This module holds the segment-mask
    allocation logic in framework-free code with no knowledge of Redis, Kafka or
    Postgres. It is the REFERENCE SPECIFICATION of the algorithm: Strategy B calls
    it directly, Strategy A reimplements it in Lua, and T-7 proves them equivalent.

    Never compiled with the enable-preview flag. Coverage target 85 percent
    (SDD 18) - the only module with one.
  -->

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-domain-purity</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>jakarta.*:*</exclude>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>io.lettuce:*</exclude>
                    <exclude>org.apache.kafka:*</exclude>
                  </excludes>
                  <message>domain/ must stay framework-free (SDD 8.2). It is the reference specification of the allocation algorithm and must be readable and testable without any infrastructure.</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
