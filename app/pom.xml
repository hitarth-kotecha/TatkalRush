<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tatkalrush</groupId>
    <artifactId>tatkal-rush</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>app</artifactId>
  <name>app (composition root and bootable jar)</name>

  <!--
    Composition root: wires every adapter into one deployable and builds the
    Spring Boot jar that runs as app-1 and app-2 (SDD 8.3).

    NOT in the SDD 8.2 module tree. The tree names adapters/web as the HTTP layer
    but never says which module assembles the deployable, and putting the main
    class in adapters/web would force web to depend on the other adapters,
    breaking the layering rule ArchUnit enforces. Raised as OQ-3 rather than
    guessed silently (SDD 0).
  -->

  <dependencies>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>allocator-redis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>allocator-swp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>messaging</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>payment-sim</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>admission</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>invariant-checker</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>--enable-preview</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
