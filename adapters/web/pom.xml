<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tatkalrush</groupId>
    <artifactId>tatkal-rush</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>web</artifactId>
  <name>adapters/web (REST, SSE, problem+json) - the only preview-enabled module</name>

  <!--
    The ONLY module compiled with the enable-preview flag (SDD 8.5, DD-004).
    StructuredTaskScope is preview in Java 25 (JEP 505); scoped values are final.

    The flag must appear in THREE places: compilerArgs below, the surefire argLine
    below, and the Dockerfile runtime JVM args. Omitting the surefire one fails as
    an opaque UnsupportedClassVersionError that reads like a JDK mismatch.

    A FOURTH case, found by the Task 1 spike and not in the SDD: any module that
    merely COMPILES AGAINST this one also needs the flag. The quarantine therefore
    holds only while nothing depends on adapters/web. ArchUnit enforces that
    (see archtest/), rather than leaving it to luck.
  -->

  <dependencies>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tatkalrush</groupId>
      <artifactId>application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>--enable-preview</arg>
            <!--
              Repeated from the root POM on purpose. Maven merges plugin
              CONFIGURATION, but a child's <compilerArgs> LIST replaces the
              inherited one rather than appending to it. So declaring the preview
              flag here silently dropped -parameters, in the one module where
              losing it breaks every @PathVariable handler at request time.
            -->
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
